{
  "version": 2,
  "builds": [
    {
      "src": "api/analyze.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/analyze",
      "dest": "/api/analyze.py"
    },
    {
      "src": "/script.js",
      "dest": "/script.js"
    },
    {
      "src": "/style.css", 
      "dest": "/style.css"
    },
    {
      "src": "/(.*)",
      "dest": "/api/analyze.py"
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.9"
  }
}
